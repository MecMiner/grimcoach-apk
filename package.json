{
  "name": "grimcoach-apk",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "expo": "~57.0.25",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.5",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "^5.2.3",
    "react-native-vision-camera-face-detector": "^2.1.0",
    "react-native-worklets": "0.10.1",
    "react-native-worklets-core": "^1.6.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "sync-images": "node scripts/generateExpressionIndex.js"
  },
  "private": true,
  "expo": {
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Este aplicativo precisa de acesso à câmera para detectar seu rosto.",
          "enableMicrophonePermission": false
        },
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "extraGradleArguments": {
              "android.aarMetadata.skip": "true"
            }
          }
        }
      ]
    ]
  }
}
